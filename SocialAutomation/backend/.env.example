# Copy to .env and replace the Django key with a random secret.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DJANGO_SECURE_COOKIES=False
DJANGO_COOKIE_SAMESITE=Lax
DJANGO_CACHE_BACKEND=django.core.cache.backends.locmem.LocMemCache
DJANGO_CACHE_LOCATION=socialautomation-auth-throttle

# Google Cloud Console: enable YouTube Data API v3 and create a restricted API key.
YOUTUBE_API_KEY=replace-with-your-youtube-data-api-v3-key
