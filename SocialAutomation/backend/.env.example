# Copy to .env and replace the Django key with a random secret.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DJANGO_SECURE_COOKIES=False
DJANGO_COOKIE_SAMESITE=Lax
DJANGO_CACHE_BACKEND=django.core.cache.backends.locmem.LocMemCache
DJANGO_CACHE_LOCATION=socialautomation-auth-throttle

# Redis is the Celery broker. Start Redis before the worker and Beat processes.
REDIS_URL=redis://127.0.0.1:6379/0
YOUTUBE_MONITORING_ENABLED=True
YOUTUBE_MONITOR_INTERVAL_SECONDS=900

# Google Cloud Console: enable YouTube Data API v3 and create a restricted API key.
YOUTUBE_API_KEY=replace-with-your-youtube-data-api-v3-key

# Meta developer app (Facebook Login). Register the callback URL exactly as below.
FACEBOOK_APP_ID=replace-with-your-meta-app-id
FACEBOOK_APP_SECRET=replace-with-your-meta-app-secret
FACEBOOK_REDIRECT_URI=http://localhost:8000/api/facebook/oauth/callback/
FACEBOOK_FRONTEND_URL=http://localhost:5173
FACEBOOK_GRAPH_API_VERSION=v27.0
# Generate with: py -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FACEBOOK_TOKEN_ENCRYPTION_KEY=replace-with-a-generated-fernet-key

# Private media and the scheduled-post dispatcher. Files are served only through authenticated API routes.
SOCIALAUTOMATION_MEDIA_ROOT=uploads
MEDIA_MAX_UPLOAD_MB=500
# Keep both switches off until Meta app review/access, OAuth permissions, Pages and worker are ready.
FACEBOOK_PUBLISHING_ENABLED=False
PUBLISHING_DISPATCH_ENABLED=True
PUBLISHING_DISPATCH_INTERVAL_SECONDS=30
PUBLISHING_DISPATCH_STALE_SECONDS=3900
PUBLISHING_MAX_RETRIES=4
